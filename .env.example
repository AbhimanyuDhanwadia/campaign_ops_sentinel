# Keep SHADOW_MODE=true until real campaign APIs, credentials, and approval workflows are in place.
APP_ENV=development
SHADOW_MODE=true
# Local default: sqlite:///./data/campaign_ops.db
DATABASE_URL=sqlite:///./data/campaign_ops.db
# Required when APP_ENV=production. Send in X-API-Key for all /v1 endpoints.
API_KEY=
OPENAI_API_KEY=
